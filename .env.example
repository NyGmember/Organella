# ==========================================
# 🧬 Organella Platform Environment Config
# ==========================================

# Core Application
APP_ENV=development
APP_NAME=Organella
DEBUG=true
PORT=8000
SECRET_KEY=organella_insecure_development_secret_key_change_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5001

# Database Configuration (PostgreSQL 16)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=organella
DATABASE_PASSWORD=organella_secret_change_me
DATABASE_NAME=organella_core
DATABASE_URL=postgresql+asyncpg://organella:organella_secret_change_me@localhost:5432/organella_core

# Caching & Event Bus (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Security & Token Lifetime
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# FHIR Interoperability Gateway
FHIR_BASE_URL=http://localhost:8000/fhir/r4
