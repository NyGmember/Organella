{
  "name": "organella-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Organella: Open-Source Modular Healthcare Platform",
  "scripts": {
    "build": "pnpm -r run build",
    "dev:shell": "pnpm --filter @organella/host-shell dev",
    "dev:opd": "pnpm --filter @organella-module/doctor-opd dev",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  }
}
